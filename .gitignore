# Files and folders to be ignored.

build/
dist/
*.egg-info/
.tox/
.python-version

# virtual env folder
env/*
.env/*
venv/*
.venv/*
envformosa/*
venvformosa/*

# cache folders and files
**/__pycache__/*
**.pyc

# edition folder
themes/edit/*

# secret themes
themes/xxx.json
themes/templates/xxx.ods
themes/templates/xxx.py

# generated secrets - the Save button writes seed phrases here in plain text
output.txt
.formosa_error.log

# Dart and Flutter
.dart_tool/
pubspec.lock

# IDE folder
.idea/
