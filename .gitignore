# Files and folders to be ignored.

build/
dist/
*.egg-info/
.tox/
.python-version

# virtual env folder
env/*
.env/*
venv/*
.venv/*
envformosa/*
venvformosa/*

# cache folders and files
**/__pycache__/*
**.pyc

# edition folder: work files stay local; the authoring inputs and the theme
# built from them are tracked (the theme tools and their tests read them)
themes/edit/*
!themes/edit/Data.json
!themes/edit/Data.txt
!themes/edit/main.json

# secret themes
themes/xxx.json
themes/templates/xxx.ods
themes/templates/xxx.py

# generated secrets - the Save button writes seed phrases here in plain text
output.txt
.formosa_error.log

# Dart and Flutter
.dart_tool/
pubspec.lock

# IDE folder
.idea/
